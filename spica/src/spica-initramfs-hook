#!/bin/sh
# SPiCa initramfs-tools hook
# Save to: /etc/initramfs-tools/hooks/spica
# Make executable: chmod +x /etc/initramfs-tools/hooks/spica

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Copy the SPiCa binary (which has the eBPF probe embedded inside it)
if [ -f "/usr/local/bin/spica" ]; then
    copy_exec /usr/local/bin/spica /bin/spica
elif [ -f "/target/release/spica" ]; then
    copy_exec /target/release/spica /bin/spica
else
    echo "Warning: SPiCa binary not found. Make sure to build and install it to /usr/local/bin/spica before running update-initramfs."
fi

# Copy TPM tools and their dependencies for hardened runtime key generation & PCR audits
if command -v tpm2_getrandom >/dev/null 2>&1; then
    copy_exec $(which tpm2_getrandom) /bin/tpm2_getrandom
fi

if command -v tpm2_pcrread >/dev/null 2>&1; then
    copy_exec $(which tpm2_pcrread) /bin/tpm2_pcrread
fi

# Copy libraries for tpm2-tools if necessary
for lib in libcrypto.so.3 libssl.so.3 libtss2-esys.so.0 libtss2-mu.so.0 libtss2-sys.so.0 libtss2-rc.so.0 libtss2-tctildr.so.0; do
    if [ -f "/usr/lib/x86_64-linux-gnu/$lib" ]; then
        copy_exec /usr/lib/x86_64-linux-gnu/$lib /lib/x86_64-linux-gnu/$lib
    fi
done

exit 0
