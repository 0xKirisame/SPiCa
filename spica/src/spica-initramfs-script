#!/bin/sh
# SPiCa initramfs init-premount script
# Save to: /etc/initramfs-tools/scripts/init-premount/spica
# Make executable: chmod +x /etc/initramfs-tools/scripts/init-premount/spica

PREREQ="udev"

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions

log_begin_msg "Starting SPiCa Early Boot Protection & Gateway..."

# 1. Mount securityfs if not already mounted (required for BPF LSM checks)
if [ ! -d "/sys/kernel/security" ]; then
    mkdir -p /sys/kernel/security
fi
if ! mountpoint -q /sys/kernel/security; then
    mount -t securityfs securityfs /sys/kernel/security >/dev/null 2>&1
fi

# 2. Mount BPF Filesystem if not already mounted (required for watchdog pin)
if [ ! -d "/sys/fs/bpf" ]; then
    mkdir -p /sys/fs/bpf
fi
if ! mountpoint -q /sys/fs/bpf; then
    mount -t bpf bpffs /sys/fs/bpf -o nosuid,nodev,noexec,mode=0700 >/dev/null 2>&1
fi

# 3. Mount efivarfs if not already mounted (required for Secure Boot checks)
if [ -d "/sys/firmware/efi/efivars" ] && ! mountpoint -q /sys/firmware/efi/efivars; then
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars >/dev/null 2>&1
fi

# 4. Start SPiCa in the background. Redirect logs to a temporary in-memory boot log.
if [ -x "/bin/spica" ]; then
    # Run SPiCa in the background
    /bin/spica >/run/spica-initramfs.log 2>&1 &
    
    # Give a brief moment for initialization to lock the gates
    sleep 0.5
    log_success_msg "SPiCa Early Boot Protection & Gateway started successfully (network locked & LKM gate armed)"
else
    log_failure_msg "SPiCa executable not found at /bin/spica in initramfs"
fi

exit 0
